# LAMA Browser Deployment Configuration
# Copy this file to .env.deploy and fill in your credentials
# Then source it before deploying: source .env.deploy && ./deploy.sh

# SFTP Connection Details
# Option 1: Separate user and host (recommended for clarity)
export SFTP_USER="myusername"
export SFTP_HOST="lama.one"

# Option 2: Combined user@host format
# export SFTP_HOST="myusername@lama.one"

export SFTP_PATH="/var/www/lama.one"
export SFTP_PORT="22"

# Authentication Method (choose one):

# Option 1: Password Authentication (requires sshpass)
# Install sshpass: brew install sshpass (macOS) or apt-get install sshpass (Linux)
export SFTP_PASSWORD="your-password-here"

# Option 2: SSH Key Authentication (recommended for security)
# Leave SFTP_PASSWORD empty and set key path
# export SFTP_PASSWORD=""
# export SFTP_KEY_PATH="$HOME/.ssh/id_rsa"

# Option 3: Default SSH Key
# Leave both SFTP_PASSWORD and SFTP_KEY_PATH empty
# Will use your default SSH key (~/.ssh/id_rsa or ssh-agent)

# Transport Method
export DEPLOY_TRANSPORT="sftp"  # or "ssh" for legacy SCP/SSH
