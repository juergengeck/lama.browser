{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@transport/*": ["./src/transport/*"],
      "@screens/*": ["./src/screens/*"],
      "@utils/*": ["./src/utils/*"],
      "@lama/ui": ["../lama.ui/src/index.ts"],
      "@lama/ui/*": ["../lama.ui/src/*"],
      "@refinio/one.core": ["../packages/one.core.expo"],
      "@refinio/one.core/*": ["../packages/one.core.expo/*"],
      "@refinio/one.models": ["../packages/one.models"],
      "@refinio/one.models/*": ["../packages/one.models/*"],
      "@chat/core": ["../chat.core"],
      "@chat/core/*": ["../chat.core/*"],
      "@lama/core": ["../lama.core"],
      "@lama/core/*": ["../lama.core/*"],
      "@lama/connection.core": ["../connection.core"],
      "@lama/connection.core/*": ["../connection.core/*"],
      "@settings/core": ["../settings.core"],
      "@settings/core/*": ["../settings.core/*"],
      "@mcp/core": ["../mcp.core"],
      "@mcp/core/*": ["../mcp.core/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
